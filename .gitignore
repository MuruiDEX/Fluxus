# dependencies
/frontend/node_modules
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/frontend/coverage
/test-results
/frontend/test-results
/playwright-report
/frontend/playwright-report

# next.js
/frontend/.next/
/frontend/out/
/out/

# production
/build
/frontend/build

# misc
.DS_Store
*.pem

# python / backend
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
backend/*.log
frontend/*.log

# env files (can opt-in for committing if needed)
.env*
!/frontend/.env.example
/.env.example
# deploy/prod.env does not match .env* because of its prod. prefix.
/deploy/prod.env
backend/.pgdata*/

# local production backups / database dumps
/deploy/backups/
*.dump

# vercel
.vercel
/frontend/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/frontend/.playwright
# live e2e session (single-run cookie, never commit)
/frontend/e2e/.auth-state.json
/frontend/test-results/
