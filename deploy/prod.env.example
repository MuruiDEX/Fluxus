# deploy/prod.env.example — production values TEMPLATE (Stage 17).
#
# Copy to deploy/prod.env and fill in REAL values:
#   cp deploy/prod.env.example deploy/prod.env
# deploy/prod.env is explicitly gitignored (see .gitignore) — NEVER commit it.
# All values below are placeholders (example.com, CHANGE_ME). Nothing here is real.
#
# DNS prerequisite: {$DOMAIN} must resolve to this server (A/AAAA record)
# before first boot so Caddy can complete ACME issuance on ports 80+443.

# Public web origin (single origin for pages + API through Caddy).
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
PUBLIC_API_ORIGIN=https://app.example.com

# PostgreSQL (internal-only network; no published port).
POSTGRES_USER=muse
POSTGRES_PASSWORD=CHANGE_ME_to_32plus_random_chars
POSTGRES_DB=muse

# Backend (pydantic APP_* settings). The password MUST match POSTGRES_PASSWORD.
APP_DATABASE_URL=postgresql+asyncpg://muse:CHANGE_ME_to_32plus_random_chars@postgres:5432/muse
# Exact frontend origin(s), JSON array, https + non-loopback (prod guard enforced).
APP_CORS_ORIGINS=["https://app.example.com"]
# AI provider: mock = fully offline (no real work). For real execution use
# openai_compat + a provider key (never committed) + reachable base URL.
APP_LLM_PROVIDER=mock
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_MODEL=gpt-4o-mini
# APP_ENVIRONMENT=prod and APP_SESSION_COOKIE_SECURE=true are pinned in
# docker-compose.prod.yml and need no entry here.
