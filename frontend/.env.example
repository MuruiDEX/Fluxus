# DEMO is a deployment mode: simulated data only, no backend calls.
NEXT_PUBLIC_APP_MODE=demo

# LIVE requires an explicit HTTPS origin. The client appends /api/v1/... .
# NEXT_PUBLIC_APP_MODE=live
# NEXT_PUBLIC_API_URL=https://app.example.com

# Test builds only (never set in production).
# NEXT_PUBLIC_ALLOW_INSECURE_API=1
